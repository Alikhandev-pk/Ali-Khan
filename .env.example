# Contact form delivery (optional). Copy to .env.local for local use, and add the same
# variables in Vercel → Project → Settings → Environment Variables, then redeploy.
# While any of these are empty, the form stays visible but clearly says it is not connected
# and never pretends a message was sent.

# API key from https://resend.com (Dashboard → API Keys). Keep it secret; it is only used on the server.
RESEND_API_KEY=

# Where messages should be delivered (your inbox).
CONTACT_TO_EMAIL=

# Sender address on a domain you have verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# For quick testing Resend allows "onboarding@resend.dev" (delivers only to your own Resend account email).
CONTACT_FROM_EMAIL=

# Public URL of the site, used for social-sharing links (e.g. https://your-domain.com).
# Optional on Vercel: if unset, the project's production URL provided by Vercel is used.
NEXT_PUBLIC_SITE_URL=
